# 2. Central Managed Database Cluster (db.reiwasakura.tech)
# Connect to PostgreSQL instance hosted at https://db.reiwasakura.tech/
DATABASE_URL=postgres://labar_app_user:YourStrongDbPassword2026!@db.reiwasakura.tech:5432/labar_production?sslmode=require&pool_max_conns=50&pool_min_conns=10

# 3. Redis Cache & Geospatial Stream
REDIS_URL=redis://redis:6379/0

# 4. Security Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET=b63c89f546ef8d91a24d86b72a50c829e2469d71c4f51e03a987d652f1e29c01
OTP_SECRET=d8a4f91b72e50631c892a4e17f03d582b1469e37c89a0245f617d983e204c519
