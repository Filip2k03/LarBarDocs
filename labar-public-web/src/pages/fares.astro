---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FaresService } from '@/services/fares.service';
import type { FareRule } from '@/types/fare';
let rules: FareRule[] = [];
let unavailable = false;
try { rules = await FaresService.getFareRules(); } catch { unavailable = true; }
const mmk = (value: number) => `${value.toLocaleString()} MMK`;
---
<BaseLayout title="Fares — LaBar Myanmar" description="Review active LaBar fare rules published by the Go pricing API.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center"><span class="badge-red">VERSIONED PRICING</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-5xl">Clear before you confirm.</h1><p class="mt-4 text-sm leading-6 text-neutral-600">These are the active fare rules returned by the backend. Your route total is calculated from a live quote, not in the browser.</p><a href="/ride?intent=quote" class="btn-primary mt-6 min-h-12">Get a route quote →</a></div>
    {unavailable ? <p class="mx-auto mt-10 max-w-2xl rounded-3xl border border-amber-200 bg-amber-50 p-7 text-center text-sm text-amber-900">Fare rules could not be reached. No prices have been filled in locally.</p> : rules.length === 0 ? <p class="mx-auto mt-10 max-w-2xl rounded-3xl border border-neutral-200 bg-white p-7 text-center text-sm text-neutral-600">No active fare rules were returned.</p> : <div class="mt-12 grid gap-5 md:grid-cols-2">{rules.map((rule) => <article class="rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft"><div class="flex items-center justify-between"><span class="rounded-full bg-red-50 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-brand-red">{rule.city}</span><span class="text-[10px] font-semibold text-neutral-400">Version {rule.version}</span></div><h2 class="mt-4 text-xl font-black capitalize text-neutral-950">{rule.ride_type}</h2><dl class="mt-5 grid grid-cols-2 gap-4 text-xs"><div><dt class="text-neutral-500">Base fare</dt><dd class="mt-1 font-extrabold text-neutral-950">{mmk(rule.base_fare_mmk)}</dd></div><div><dt class="text-neutral-500">Included distance</dt><dd class="mt-1 font-extrabold text-neutral-950">{(rule.included_distance_meters / 1000).toFixed(1)} km</dd></div><div><dt class="text-neutral-500">Additional kilometre</dt><dd class="mt-1 font-extrabold text-neutral-950">{mmk(rule.per_km_mmk)}</dd></div><div><dt class="text-neutral-500">Low-speed minute</dt><dd class="mt-1 font-extrabold text-neutral-950">{mmk(rule.low_speed_per_minute_mmk)}</dd></div><div><dt class="text-neutral-500">Booking fee</dt><dd class="mt-1 font-extrabold text-neutral-950">{mmk(rule.booking_fee_mmk)}</dd></div><div><dt class="text-neutral-500">Service fee</dt><dd class="mt-1 font-extrabold text-neutral-950">{mmk(rule.service_fee_mmk)}</dd></div></dl></article>)}</div>}
  </main>
</BaseLayout>
