---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SupportTicketForm } from '@/components/help/SupportTicketForm';
---
<BaseLayout title="Contact LaBar" description="Send a support, partnership, or general inquiry to LaBar.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center"><span class="badge-red">GET IN TOUCH</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-5xl">Start with what you need.</h1><p class="mt-4 text-sm leading-6 text-neutral-600">Send your message through the form below. A confirmation appears only after the LaBar API accepts it.</p></div>
    <div class="mt-10"><SupportTicketForm client:load /></div>
  </main>
</BaseLayout>
