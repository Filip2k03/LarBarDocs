---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
import { SupportTicketForm } from '@/components/help/SupportTicketForm';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="Contact Us — LaBar Head Office & 24/7 Hotline"
  description="Contact LaBar Myanmar. Head office in Yangon, regional branches in Mandalay & Naypyidaw, and 24/7 emergency customer hotline."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <span class="badge-red">GET IN TOUCH</span>
      <h1 class="text-3xl sm:text-4xl font-black text-neutral-900 tracking-tight">
        We Are Here For You 24/7
      </h1>
      <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
        Reach our emergency support center, commercial partnership desk, or visit our local branches across Myanmar.
      </p>
    </div>

    <!-- 3 Office Contact Cards with Vector Icons -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="bg-white rounded-4xl p-6 border border-brand-border shadow-soft space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-red-50 text-brand-red flex items-center justify-center border border-red-100">
          <Icon name="location" size={20} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900">Yangon Central HQ</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          No. 142, Sule Pagoda Road, Kyauktada Township, Yangon Region, Myanmar.
        </p>
        <div class="pt-2 text-xs font-bold text-neutral-800 flex items-center gap-1.5">
          <Icon name="phone" size={14} class="text-brand-red" />
          <span>+95 9 798 421092</span>
        </div>
      </div>

      <div class="bg-white rounded-4xl p-6 border border-brand-border shadow-soft space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-100">
          <Icon name="location" size={20} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900">Mandalay Regional Hub</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          78th Street, Between 30th &amp; 31st Street, Chanayethazan, Mandalay.
        </p>
        <div class="pt-2 text-xs font-bold text-neutral-800 flex items-center gap-1.5">
          <Icon name="phone" size={14} class="text-amber-600" />
          <span>+95 9 450 012948</span>
        </div>
      </div>

      <div class="bg-white rounded-4xl p-6 border border-brand-border shadow-soft space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center border border-blue-100">
          <Icon name="mail" size={20} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900">Direct Inquiries</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Support: <a href="mailto:support@labar.com.mm" class="text-brand-red font-semibold">support@labar.com.mm</a> <br />
          Enterprise: <a href="mailto:business@labar.com.mm" class="text-brand-red font-semibold">business@labar.com.mm</a>
        </p>
        <div class="pt-2 text-xs font-bold text-emerald-600 flex items-center gap-1.5">
          <Icon name="check" size={14} />
          <span>24/7 Response Time &lt; 15 mins</span>
        </div>
      </div>
    </div>

    <!-- Contact Form Island -->
    <SupportTicketForm client:load />
  </div>
</BaseLayout>
