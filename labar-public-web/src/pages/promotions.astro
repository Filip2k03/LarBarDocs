---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PromotionsService } from '@/services/promotions.service';
import type { Promotion } from '@/types/promotion';
let promotions: Promotion[] = [];
let unavailable = false;
try { promotions = await PromotionsService.getActivePromotions(); } catch { unavailable = true; }
const amount = (promo: Promotion) => promo.discount_percent ? `${promo.discount_percent}% off` : promo.discount_fixed_mmk ? `${promo.discount_fixed_mmk.toLocaleString()} MMK off` : 'Offer';
---
<BaseLayout title="Promotions — LaBar Myanmar" description="See active offers returned by the LaBar promotions API.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center"><span class="badge-red">LIVE OFFERS</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-5xl">A little more journey for your kyat.</h1><p class="mt-4 text-sm leading-6 text-neutral-600">Only active promotions returned by LaBar’s Go API appear here.</p></div>
    {unavailable ? <div class="mx-auto mt-10 max-w-2xl rounded-3xl border border-amber-200 bg-amber-50 p-7 text-center"><h2 class="font-extrabold text-amber-950">Promotions are unavailable right now.</h2><p class="mt-2 text-sm text-amber-800">We could not reach the promotions API. No placeholder offers have been substituted.</p></div> : promotions.length === 0 ? <p class="mx-auto mt-10 max-w-2xl rounded-3xl border border-neutral-200 bg-white p-8 text-center text-sm text-neutral-600">There are no active promotions at the moment.</p> : <div class="mt-10 grid gap-5 md:grid-cols-2">{promotions.map((promo) => <article class="relative overflow-hidden rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft"><div class="absolute right-0 top-0 h-28 w-28 rounded-bl-full bg-brand-yellow/25"></div><p class="text-xs font-bold uppercase tracking-[.16em] text-brand-red">{amount(promo)}</p><h2 class="relative mt-3 text-2xl font-black text-neutral-950">{promo.name}</h2><p class="mt-3 text-xs text-neutral-500">Valid {new Date(promo.starts_at).toLocaleDateString()}–{new Date(promo.ends_at).toLocaleDateString()}</p>{promo.codes.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{promo.codes.map((code) => <span class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 font-mono text-xs font-bold text-brand-red">{code}</span>)}</div>}<a href={`/ride?promo=${encodeURIComponent(promo.codes[0] || '')}`} class="btn-primary mt-6 min-h-11">Use this offer →</a></article>)}</div>}
  </main>
</BaseLayout>
