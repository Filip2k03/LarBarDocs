---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="Download LaBar Passenger & Driver Apps — iOS & Android"
  description="Download the LaBar mobile apps for iOS and Android. Direct APK downloads, instant 1-tap booking, and dynamic safety plugins."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-red">NATIVE MOBILE APPLICATIONS</span>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        Download LaBar for iOS &amp; Android. <br />
        <span class="text-brand-red">Your Care Begins with a Single Tap.</span>
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
        Ultra-lightweight native apps (under 25MB) with dynamic on-demand safety modules and full offline ride continuation.
      </p>
    </div>

    <!-- 2 Main App Downloads Cards with Vector Icons -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Passenger App -->
      <div class="bg-white rounded-4xl p-8 border border-brand-border shadow-soft flex flex-col justify-between space-y-6">
        <div>
          <div class="w-14 h-14 rounded-3xl bg-brand-lightRed text-brand-red flex items-center justify-center border border-red-200 mb-4">
            <Icon name="taxi" size={26} />
          </div>
          <span class="text-xs font-bold text-brand-red uppercase">Passenger Application</span>
          <h3 class="text-2xl font-extrabold text-neutral-900 mt-1 mb-2">LaBar Passenger</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Multi-stop booking, real-time in-trip taximeter, in-app driver phone calls, and KBZPay/WavePay cashless settlements.
          </p>

          <ul class="space-y-1.5 pt-4 text-xs text-neutral-700 font-semibold">
            <li class="flex items-center gap-2">✓ iOS 15.0+ &amp; Android 8.0+</li>
            <li class="flex items-center gap-2">✓ 24.8 MB Ultra-Fast Download</li>
            <li class="flex items-center gap-2">✓ English &amp; Myanmar Language</li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-neutral-100">
          <a
            href="https://apps.apple.com"
            class="flex-1 py-3 px-4 rounded-2xl bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold text-center transition-all flex items-center justify-center gap-2"
          >
            <Icon name="apple" size={15} />
            <span>App Store (iOS)</span>
          </a>
          <a
            href="https://play.google.com"
            class="flex-1 py-3 px-4 rounded-2xl bg-brand-red hover:bg-brand-deepRed text-white text-xs font-bold text-center transition-all shadow-sm flex items-center justify-center gap-2"
          >
            <Icon name="playstore" size={15} />
            <span>Google Play</span>
          </a>
        </div>
      </div>

      <!-- Driver App -->
      <div class="bg-white rounded-4xl p-8 border border-brand-border shadow-soft flex flex-col justify-between space-y-6">
        <div>
          <div class="w-14 h-14 rounded-3xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-200 mb-4">
            <Icon name="driver" size={26} />
          </div>
          <span class="text-xs font-bold text-amber-700 uppercase">Driver Partner Application</span>
          <h3 class="text-2xl font-extrabold text-neutral-900 mt-1 mb-2">LaBar Driver</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Manage availability, navigation, ride offers, active trips, earnings history, support and safety events from one driver experience.
          </p>

          <ul class="space-y-1.5 pt-4 text-xs text-neutral-700 font-semibold">
            <li class="flex items-center gap-2">✓ Optimized for Android 8.0+</li>
            <li class="flex items-center gap-2">✓ Instant Background Telemetry</li>
            <li class="flex items-center gap-2">✓ Direct APK Download Available</li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-neutral-100">
          <a
            href="https://play.google.com"
            class="flex-1 py-3 px-4 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold text-center transition-all shadow-sm flex items-center justify-center gap-2"
          >
            <Icon name="playstore" size={15} />
            <span>Google Play Store</span>
          </a>
          <a
            href="/downloads/labar-driver.apk"
            class="flex-1 py-3 px-4 rounded-2xl bg-neutral-100 hover:bg-neutral-200 text-neutral-900 text-xs font-bold text-center transition-all border border-neutral-200"
          >
            Direct APK (.apk)
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
