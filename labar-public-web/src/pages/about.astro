---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="About LaBar — Proudly Myanmar Mobility Innovation"
  description="Learn about LaBar's founding mission: creating the safest, most reliable and transparent transportation and safety ecosystem for Myanmar."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-red">OUR MISSION &amp; HERITAGE</span>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        Built in Myanmar. <br />
        <span class="text-brand-red">Engineered for Care, Safety &amp; Dignity.</span>
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
        LaBar was created with a clear purpose: to modernize urban transportation across Myanmar through transparent fares, verified driver dignity, and world-class safety technology.
      </p>
    </div>

    <!-- 3 Pillars with Vector SVG Icons -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-4xl p-8 border border-brand-border shadow-soft space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-red-50 text-brand-red flex items-center justify-center border border-red-200">
          <Icon name="heart" size={22} color="#E53935" />
        </div>
        <h3 class="text-lg font-extrabold text-neutral-900">Driver Partner Dignity</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          We believe drivers are the backbone of urban economy. With an industry-low 15% commission and instant daily digital payouts, our driver partners earn the highest take-home income in Myanmar.
        </p>
      </div>

      <div class="bg-white rounded-4xl p-8 border border-brand-border shadow-soft space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-200">
          <Icon name="guardian" size={22} color="#D97706" />
        </div>
        <h3 class="text-lg font-extrabold text-neutral-900">Uncompromising Safety</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Through the LaBar Guardian safety system, 1km SOS mesh intercept, and in-cabin video sentinel, we provide unmatched peace of mind for women, late-night workers, and families.
        </p>
      </div>

      <div class="bg-white rounded-4xl p-8 border border-brand-border shadow-soft space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-200">
          <Icon name="payout" size={22} color="#059669" />
        </div>
        <h3 class="text-lg font-extrabold text-neutral-900">Modern Engineering</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Powered by a lightweight high-concurrency Golang backend, sub-100ms Redis geospatial indexing, and native mobile applications optimized for Myanmar network conditions.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
