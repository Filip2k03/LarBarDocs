---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
import { DriverApplicationForm } from '@/components/driver/DriverApplicationForm';
import { EarningsCalculator } from '@/components/driver/EarningsCalculator';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="Drive with LaBar — Earn on Your Terms | Highest Driver Payouts in Myanmar"
  description="Join LaBar as a driver partner in Yangon, Mandalay, and across Myanmar. Enjoy lowest 15% commission, daily instant KBZPay payouts, and 24/7 SOS safety support."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-gold">DRIVER PARTNER PROGRAM</span>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        Earn on Your Terms. <br />
        <span class="text-brand-red">Drive with Pride Across Myanmar.</span>
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
        Join over 5,000+ verified driver partners. Work whenever you want with guaranteed lowest 15% platform commission and daily instant digital earnings settlement.
      </p>
    </div>

    <!-- 4 Key Driver Benefits with Crisp Vector SVGs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center mb-4 border border-amber-200">
          <Icon name="money" size={22} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900 mb-2">15% Lowest Commission</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Keep 85% of every single fare. No hidden vehicle leasing fees or unexpected administrative cuts.
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-4 border border-emerald-200">
          <Icon name="payout" size={22} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900 mb-2">Daily Instant Payouts</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Withdraw your completed trip earnings directly into your KBZPay, WavePay, or bank account every single night.
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-red-50 text-brand-red flex items-center justify-center mb-4 border border-red-200">
          <Icon name="sos" size={22} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900 mb-2">1km SOS Distress Mesh</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Feel secure late at night with silent steering SOS triggers and automated rapid response by nearby peer drivers.
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center mb-4 border border-blue-200">
          <Icon name="flexible" size={22} />
        </div>
        <h3 class="text-base font-extrabold text-neutral-900 mb-2">100% Flexible Hours</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Drive full-time, part-time, or on weekends. Turn the LaBar Driver App on and off anytime without penalties.
        </p>
      </div>
    </div>

    <!-- Earnings Calculator & Application Form Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <div>
        <EarningsCalculator client:visible />
      </div>
      <div>
        <DriverApplicationForm client:load />
      </div>
    </div>
  </div>
</BaseLayout>
