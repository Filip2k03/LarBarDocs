---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="Cookie Policy — LaBar Myanmar"
  description="Details on how LaBar uses cookies and local storage tokens for session security and language preferences."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-8">
    <div class="border-b border-neutral-200 pb-6">
      <span class="badge-red mb-2">PRIVACY &amp; STORAGE</span>
      <h1 class="text-3xl font-black text-neutral-900 tracking-tight">Cookie Policy</h1>
      <p class="text-xs text-neutral-500 mt-1">Effective Date: 1 January 2026 • Last updated: August 2026</p>
    </div>

    <div class="prose prose-neutral max-w-none text-xs sm:text-sm text-neutral-700 space-y-6 leading-relaxed">
      <section>
        <h2 class="text-base font-extrabold text-neutral-900 mb-2">1. Use of Cookies &amp; Local Storage</h2>
        <p>
          We use strictly necessary cookies and local browser storage to remember your language preference (English / Myanmar), maintain secure authentication tokens, and preserve your route quote state.
        </p>
      </section>

      <section>
        <h2 class="text-base font-extrabold text-neutral-900 mb-2">2. Managing Preferences</h2>
        <p>
          You can clear your cookies or adjust browser security settings at any time without impacting basic ride booking capabilities.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
