---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);
---

<BaseLayout
  title="Terms of Service — LaBar Myanmar"
  description="Terms and conditions governing the use of LaBar passenger ride-hailing, driver partner services, and delivery platform."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-8">
    <div class="border-b border-neutral-200 pb-6">
      <span class="badge-red mb-2">USER AGREEMENT</span>
      <h1 class="text-3xl font-black text-neutral-900 tracking-tight">Terms of Service</h1>
      <p class="text-xs text-neutral-500 mt-1">Effective Date: 1 January 2026 • Last updated: August 2026</p>
    </div>

    <div class="prose prose-neutral max-w-none text-xs sm:text-sm text-neutral-700 space-y-6 leading-relaxed">
      <section>
        <h2 class="text-base font-extrabold text-neutral-900 mb-2">1. Acceptance of Terms</h2>
        <p>
          By creating an account, booking a ride, or registering as a driver partner on the LaBar platform, you agree to comply with and be legally bound by these Terms of Service.
        </p>
      </section>

      <section>
        <h2 class="text-base font-extrabold text-neutral-900 mb-2">2. Transparent Fare Policy</h2>
        <p>
          All ride fares quoted prior to trip confirmation are binding guaranteed maximum estimates, calculated using official municipal transport tariffs.
        </p>
      </section>

      <section>
        <h2 class="text-base font-extrabold text-neutral-900 mb-2">3. Community Safety &amp; Conduct</h2>
        <p>
          LaBar maintains a strict zero-tolerance policy against harassment, intoxication while operating vehicles, and discriminatory behavior. Violations result in immediate suspension.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
