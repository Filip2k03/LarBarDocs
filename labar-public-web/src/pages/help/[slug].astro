---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HelpService } from '@/services/help.service';
import { SupportTicketForm } from '@/components/help/SupportTicketForm';
import type { HelpArticle } from '@/types/help';

export async function getStaticPaths() {
  try {
    const articles = await HelpService.getArticles();
    return articles.map((summary) => ({ params: { slug: summary.slug }, props: { summary } }));
  } catch { return []; }
}
const { summary } = Astro.props as { summary: HelpArticle };
let article = summary;
try { article = await HelpService.getArticleBySlug(summary.slug); } catch { /* summary remains real API data */ }
const body = typeof article.body === 'string' ? article.body : article.body ? JSON.stringify(article.body, null, 2) : '';
---
<BaseLayout title={`${article.title} — LaBar Help`} description={`LaBar help article: ${article.title}`}>
  <main class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-neutral-500"><a href="/help" class="hover:text-brand-red">Help</a><span class="mx-2">/</span><span class="text-neutral-900">{article.title}</span></nav>
    <article class="mt-7 rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft sm:p-10"><span class="badge-red">{article.category}</span><h1 class="mt-4 text-3xl font-black tracking-tight text-neutral-950 sm:text-4xl">{article.title}</h1>{body ? <div class="mt-7 whitespace-pre-wrap border-t border-neutral-100 pt-7 text-sm leading-7 text-neutral-700">{body}</div> : <p class="mt-7 border-t border-neutral-100 pt-7 text-sm text-neutral-500">This article has no published body content.</p>}</article>
    <section class="mt-12"><SupportTicketForm client:visible /></section>
  </main>
</BaseLayout>
