---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HelpSearch } from '@/components/help/HelpSearch';
import { SupportTicketForm } from '@/components/help/SupportTicketForm';
import { HelpService } from '@/services/help.service';
import { getTranslation, defaultLocale } from '@/i18n';
import type { HelpCategory } from '@/types/help';

const locale = defaultLocale;
const t = getTranslation(locale);

let categories: HelpCategory[] = [];
try {
  categories = await HelpService.getCategories();
} catch {
  categories = [
    { id: 'cat_1', slug: 'rides', name: 'Rides & Booking', name_mm: 'ခရီးစဉ်များ', description: 'Booking, cancellation, multi-stop trips, and route tracking.', description_mm: 'ခရီးစဉ်ခေါ်ယူခြင်းနှင့် လမ်းကြောင်းအကြောင်း။', icon_name: 'car', article_count: 14 },
    { id: 'cat_2', slug: 'payments', name: 'Payments & Pricing', name_mm: 'ငွေပေးချေမှု', description: 'KBZPay, WavePay, promo vouchers, and refunds.', description_mm: 'ဒစ်ဂျစ်တယ်ငွေပေးချေခြင်းနှင့် လျှော့စျေးများ။', icon_name: 'credit-card', article_count: 12 },
    { id: 'cat_3', slug: 'driver', name: 'Driver Partners', name_mm: 'ယာဉ်မောင်းအကူအညီ', description: 'Earnings, KYC onboarding, ratings, and vehicle inspection.', description_mm: 'ယာဉ်မောင်းစာရင်းသွင်းခြင်းနှင့် ဝင်ငွေ။', icon_name: 'user', article_count: 18 },
    { id: 'cat_4', slug: 'safety', name: 'Safety & Guardian', name_mm: 'လုံခြုံရေး', description: 'LaBar Guardian, 1km SOS mesh, and emergency response.', description_mm: 'အရေးပေါ်အကာအကွယ်နှင့် လုံခြုံရေး။', icon_name: 'shield', article_count: 8 },
    { id: 'cat_5', slug: 'lost-items', name: 'Lost & Found', name_mm: 'ပစ္စည်းကျန်ရှိမှု', description: 'Recover items left in vehicles with 24/7 support.', description_mm: 'ကားပေါ်တွင် ပစ္စည်းကျန်ခဲ့ပါက ပြန်လည်ရှာဖွေခြင်း။', icon_name: 'briefcase', article_count: 5 },
    { id: 'cat_6', slug: 'business', name: 'Corporate Business', name_mm: 'စီးပွားရေးလုပ်ငန်းသုံး', description: 'Centralized billing, tax invoices, and company rides.', description_mm: 'ကုမ္ပဏီသုံး ဘေလ်ရှင်းစနစ်နှင့် ပြေစာများ။', icon_name: 'building', article_count: 7 },
  ];
}
---

<BaseLayout
  title="Help & Support Center — LaBar Myanmar"
  description="Find answers to common questions about rides, payments, driver partner support, and LaBar Guardian safety."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="badge-red">24/7 SUPPORT CENTER</span>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight">
        How Can We Help You Today?
      </h1>
      <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
        Search our knowledge base or submit a support ticket for instant resolution.
      </p>
    </div>

    <!-- Live Search Island -->
    <HelpSearch client:load />

    <!-- Help Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {categories.map((cat) => (
        <a
          href={`/help/${cat.slug}`}
          class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft hover:shadow-soft-md hover:border-brand-red/30 transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-2xl bg-neutral-100 group-hover:bg-brand-lightRed group-hover:text-brand-red flex items-center justify-center text-lg mb-3 transition-colors">
              📁
            </div>
            <h3 class="text-base font-extrabold text-neutral-900 group-hover:text-brand-red transition-colors mb-1">
              {cat.name}
            </h3>
            <p class="text-xs text-neutral-500 leading-relaxed line-clamp-2">
              {cat.description}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-neutral-400 group-hover:text-brand-red">
            <span>{cat.article_count} Articles</span>
            <span>❯</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Submit Ticket Form Island -->
    <div class="pt-8">
      <SupportTicketForm client:visible />
    </div>
  </div>
</BaseLayout>
