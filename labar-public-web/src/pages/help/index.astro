---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HelpSearch } from '@/components/help/HelpSearch';
import { SupportTicketForm } from '@/components/help/SupportTicketForm';
import { HelpService } from '@/services/help.service';
import type { HelpCategory } from '@/types/help';
let categories: HelpCategory[] = [];
let unavailable = false;
try { categories = await HelpService.getCategories(); } catch { unavailable = true; }
---
<BaseLayout title="Help & Support — LaBar" description="Search LaBar help content or submit a support request.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center"><span class="badge-red">HELP CENTER</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-5xl">How can we help?</h1><p class="mt-4 text-sm leading-6 text-neutral-600">Search published guidance from the LaBar API or send a support ticket to the operations team.</p></div>
    <div class="mt-9"><HelpSearch client:load /></div>
    {unavailable ? <p class="mx-auto mt-9 max-w-2xl rounded-3xl border border-amber-200 bg-amber-50 p-6 text-center text-sm text-amber-900">Help categories are temporarily unavailable.</p> : categories.length > 0 && <section class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{categories.map((category) => <a href={`/help/${category.slug}`} class="rounded-3xl border border-neutral-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-red/30 hover:shadow-lg"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-brand-red">Help topic</p><h2 class="mt-3 text-lg font-black text-neutral-950">{category.name}</h2><span class="mt-5 inline-block text-xs font-bold text-neutral-500">Read articles →</span></a>)}</section>}
    <section class="mt-16"><SupportTicketForm client:visible /></section>
  </main>
</BaseLayout>
