---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
const features = [
  { icon: 'driver', title: 'Driver verification', text: 'Passenger-safe driver and vehicle details are shown for an assigned ride while private identity records stay protected.' },
  { icon: 'guardian', title: 'Trusted contacts', text: 'Passengers can prepare trusted contacts and share relevant trip progress with a secure, expiring link.' },
  { icon: 'route', title: 'Route monitoring', text: 'The platform can record route deviations, unexpected stops, or unavailable GPS as reviewable safety events.' },
  { icon: 'support', title: 'Safety reporting', text: 'Passenger and driver reports create an auditable case for the operations team instead of making unverified emergency claims.' },
  { icon: 'map', title: 'Trip-aware location privacy', text: 'Precise driver location is limited to operationally relevant ride states and authorized viewers.' },
  { icon: 'notifications', title: 'SOS event routing', text: 'An SOS creates an immediate platform safety event and notifies configured contacts and operations integrations.' },
];
---
<BaseLayout title="LaBar Guardian — Safety by design" description="Explore LaBar trip sharing, trusted contacts, driver verification, route monitoring, SOS events and safety reporting.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_.75fr] lg:items-end"><div><span class="badge-red">LABAR GUARDIAN</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-6xl">Safer choices, built into every trip.</h1><p class="mt-5 max-w-2xl text-base leading-7 text-neutral-600">Guardian connects identity, trip context, location privacy and support workflows so passengers, drivers and operations can respond with clearer information.</p></div><div class="rounded-[2rem] bg-neutral-950 p-6 text-white"><p class="text-xs font-bold uppercase tracking-[.18em] text-brand-yellow">Important</p><p class="mt-3 text-sm leading-6 text-neutral-300">LaBar never claims emergency services were contacted unless a real emergency integration confirms it.</p></div></div>
    <section class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{features.map((feature) => <article class="rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft"><div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-50 text-brand-red"><Icon name={feature.icon} size={22} /></div><h2 class="mt-5 text-lg font-black text-neutral-950">{feature.title}</h2><p class="mt-2 text-sm leading-6 text-neutral-600">{feature.text}</p></article>)}</section>
  </main>
</BaseLayout>
