---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CitiesService } from '@/services/cities.service';
import type { City } from '@/types/city';
let cities: City[] = [];
let unavailable = false;
try { cities = await CitiesService.getAllCities(); } catch { unavailable = true; }
---
<BaseLayout title="Cities — LaBar Myanmar" description="Explore cities and services currently published by LaBar.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center"><span class="badge-red">SERVICE AREAS</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-5xl">Where LaBar can meet you.</h1><p class="mt-4 text-sm leading-6 text-neutral-600">Coverage is read directly from the Go API, so you only see cities the operations team has activated.</p></div>
    {unavailable ? <div class="mx-auto mt-10 max-w-2xl rounded-3xl border border-amber-200 bg-amber-50 p-7 text-center text-sm text-amber-900">City coverage could not be loaded. No locations have been guessed or substituted.</div> : cities.length === 0 ? <p class="mx-auto mt-10 max-w-2xl rounded-3xl border border-neutral-200 bg-white p-8 text-center text-sm text-neutral-600">No active cities were returned.</p> : <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{cities.map((city) => <a href={`/cities/${city.slug}`} class="group rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-brand-red/30 hover:shadow-xl"><div class="flex items-center justify-between"><span class="rounded-full bg-neutral-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-neutral-600">{city.currency}</span><span class="text-brand-red transition group-hover:translate-x-1">→</span></div><h2 class="mt-5 text-2xl font-black text-neutral-950">{city.name}</h2><p class="mt-2 text-xs text-neutral-500">{city.timezone}</p><div class="mt-5 flex flex-wrap gap-2">{city.services?.map((service) => <span class="rounded-lg bg-red-50 px-2.5 py-1 text-[10px] font-bold uppercase text-brand-red">{service}</span>)}</div></a>)}</div>}
  </main>
</BaseLayout>
