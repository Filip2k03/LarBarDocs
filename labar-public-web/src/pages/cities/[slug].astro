---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CitiesService } from '@/services/cities.service';
import { RideTiersGrid } from '@/components/home/RideTiersGrid';
import { BookingWizard } from '@/components/booking/BookingWizard';
import type { City } from '@/types/city';

export async function getStaticPaths() {
  try {
    const cities = await CitiesService.getAllCities();
    return cities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
  } catch { return []; }
}
const { city } = Astro.props as { city: City };
---
<BaseLayout title={`Ride in ${city.name} — LaBar`} description={`Explore LaBar services currently available in ${city.name}.`}>
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-neutral-500"><a href="/cities" class="hover:text-brand-red">Cities</a><span class="mx-2">/</span><span class="text-neutral-900">{city.name}</span></nav>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_.65fr] lg:items-end"><div><span class="badge-red">{city.currency} · {city.timezone}</span><h1 class="mt-4 text-4xl font-black tracking-tight text-neutral-950 sm:text-6xl">Move around {city.name}, your way.</h1><p class="mt-4 max-w-2xl text-sm leading-7 text-neutral-600">Choose from services currently enabled for this city, then sign in for a route quote from the LaBar API.</p></div><div class="flex flex-wrap gap-2">{city.services?.map((service) => <span class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-xs font-bold capitalize text-neutral-700">{service}</span>)}</div></div>
    <section class="mt-14"><BookingWizard client:load /></section>
    <section class="mt-16"><h2 class="mb-6 text-2xl font-black text-neutral-950">Ride types returned for {city.name}</h2><RideTiersGrid client:visible citySlug={city.slug} /></section>
  </main>
</BaseLayout>
