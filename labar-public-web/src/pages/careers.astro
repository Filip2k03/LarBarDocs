---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslation, defaultLocale } from '@/i18n';

const locale = defaultLocale;
const t = getTranslation(locale);

const openRoles = [
  {
    id: 'job_1',
    title: 'Senior Backend Engineer (Golang & Distributed Systems)',
    dept: 'Engineering',
    location: 'Yangon Central HQ / Hybrid',
    type: 'Full-Time',
    desc: 'Scale our high-throughput ride matching engine, spatial Redis index, and WebSocket telemetry pipeline.',
  },
  {
    id: 'job_2',
    title: 'Senior Mobile Engineer (React Native & Performance)',
    dept: 'Engineering',
    location: 'Yangon Central HQ',
    type: 'Full-Time',
    desc: 'Craft responsive passenger and driver experiences with resilient state recovery.',
  },
  {
    id: 'job_3',
    title: 'KYC Operations & Driver Verification Specialist',
    dept: 'Operations',
    location: 'Yangon (Sule / Hlaing Branches)',
    type: 'Full-Time',
    desc: 'Verify driver licences, NRC smartcards, and conduct in-person driver safety onboarding.',
  },
  {
    id: 'job_4',
    title: 'Safety & Operations Response Specialist',
    dept: 'Safety & Trust',
    location: 'Yangon Central Control Room',
    type: 'Shift-Based',
    desc: 'Monitor real-time SOS alerts, route deviation anomalies, and coordinate emergency assistance.',
  },
];
---

<BaseLayout
  title="Careers at LaBar — Build the Future of Myanmar Mobility"
  description="Join the LaBar team in Yangon. Open engineering, operations, driver relations, and customer safety positions."
  locale={locale}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-red">JOIN OUR TEAM</span>
      <h1 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        Build with Pride. <br />
        <span class="text-brand-red">Shape the Future of Myanmar Transportation.</span>
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-2xl mx-auto">
        We are a fast-growing team of passionate technologists, operators, and safety specialists committed to creating world-class technology for our country.
      </p>
    </div>

    <!-- Job Openings Grid -->
    <div class="max-w-4xl mx-auto space-y-4">
      {openRoles.map((role) => (
        <div class="bg-white rounded-3xl p-6 border border-brand-border shadow-soft flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="px-2.5 py-0.5 rounded-full bg-brand-bg text-neutral-600 text-[11px] font-bold">
                {role.dept}
              </span>
              <span class="text-xs font-semibold text-neutral-400">•</span>
              <span class="text-xs font-semibold text-neutral-500">{role.location}</span>
            </div>
            <h3 class="text-base font-extrabold text-neutral-900">{role.title}</h3>
            <p class="text-xs text-neutral-500 mt-1 max-w-xl">{role.desc}</p>
          </div>

          <a
            href="mailto:careers@labar.com.mm?subject=Application: "
            class="btn-secondary text-xs py-2.5 px-4 shrink-0"
          >
            Apply Now
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
