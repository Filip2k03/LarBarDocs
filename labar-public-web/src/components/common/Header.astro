---
import { LanguageSwitcher } from './LanguageSwitcher';
import { getTranslation, defaultLocale } from '@/i18n';
import { isNavigationItemActive, navigationItems } from '@/config/navigation';

interface Props { locale?: 'en' | 'my'; }

const { locale = defaultLocale } = Astro.props;
const t = getTranslation(locale);
const links = navigationItems.map((item) => ({
  ...item,
  label: t.nav[item.labelKey],
  active: isNavigationItemActive(Astro.url.pathname, item.href),
}));
---

<header class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-2 px-3 min-[375px]:px-4 sm:h-[72px] sm:px-6 lg:px-8">
    <a href="/" class="group flex min-h-11 shrink-0 items-center gap-2 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2" aria-label="LaBar home">
      <img src="/logo.png" alt="" class="h-8 w-auto object-contain sm:h-9" />
      <span class="hidden text-xl font-black tracking-[-.04em] text-neutral-950 min-[360px]:inline sm:text-2xl">La<span class="text-brand-red">Bar</span></span>
    </a>

    <nav class="hidden items-center gap-3 text-[11px] font-bold text-neutral-700 xl:flex 2xl:gap-5" aria-label="Main navigation">
      {links.filter((link) => link.desktop).map((link) => (
        <a href={link.href} aria-current={link.active ? 'page' : undefined} class:list={[
          'relative flex min-h-11 items-center whitespace-nowrap rounded-lg px-1 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2',
          link.active ? 'text-brand-red after:absolute after:inset-x-1 after:bottom-1 after:h-0.5 after:rounded-full after:bg-brand-red' : 'hover:text-brand-red',
        ]}>{link.label}</a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <div class="hidden xl:block"><LanguageSwitcher client:load currentLocale={locale} /></div>
      <a href="/ride?intent=book" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-red px-3 text-xs font-bold text-white shadow-sm transition hover:bg-brand-deepRed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 active:scale-[.98] min-[390px]:px-3.5 sm:px-5">
        <span class="hidden min-[390px]:inline">{t.nav.bookRide}</span><span class="min-[390px]:hidden">Ride</span>
        <svg class="ml-1.5 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <button id="mobileMenuBtn" data-testid="mobile-menu-open" type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full text-neutral-800 transition hover:bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2 xl:hidden" aria-label="Open navigation menu" aria-controls="mobileMenuDrawer" aria-expanded="false">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div id="mobileMenuDrawer" data-testid="mobile-menu-drawer" data-open="false" class="fixed inset-0 z-50 overflow-hidden bg-neutral-950/45 backdrop-blur-sm xl:hidden" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Navigation menu">
    <div id="mobileMenuPanel" class="fixed inset-y-0 right-0 flex w-[min(100%,24rem)] flex-col overflow-hidden bg-[#f7f7f5] shadow-2xl">
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-neutral-200 bg-white px-4 min-[375px]:px-5 sm:h-[72px]">
        <a href="/" class="flex min-h-11 items-center gap-2 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2"><img src="/logo.png" alt="" class="h-8 w-auto" /><span class="text-xl font-black tracking-tight">La<span class="text-brand-red">Bar</span></span></a>
        <button id="closeMobileMenuBtn" data-testid="mobile-menu-close" type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-neutral-100 text-neutral-800 transition hover:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2" aria-label="Close navigation menu"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-width="2" stroke-linecap="round" /></svg></button>
      </div>

      <div class="flex-1 overscroll-contain overflow-y-auto px-3 py-4 min-[375px]:px-4 min-[375px]:py-5 sm:px-5">
        <div class="mb-5 flex min-h-12 items-center justify-between gap-3 rounded-2xl border border-neutral-200 bg-white p-2 pl-4"><span class="text-xs font-bold text-neutral-600">Language</span><LanguageSwitcher client:load currentLocale={locale} /></div>
        <p class="px-1 text-[10px] font-bold uppercase tracking-[.2em] text-neutral-500">Explore LaBar</p>
        <nav class="mt-3 grid grid-cols-2 gap-2" aria-label="Mobile navigation">
          {links.map((link) => (
            <a href={link.href} aria-current={link.active ? 'page' : undefined} class:list={[
              'flex min-h-12 items-center justify-between gap-2 rounded-2xl border px-3 text-[12px] font-bold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-1 min-[375px]:px-3.5',
              link.active ? 'border-red-200 bg-red-50 text-brand-red' : 'border-neutral-200 bg-white text-neutral-800 hover:border-red-200 hover:bg-red-50 hover:text-brand-red',
            ]}><span>{link.label}</span><span aria-hidden="true">→</span></a>
          ))}
        </nav>
      </div>

      <div class="shrink-0 border-t border-neutral-200 bg-white p-3 pb-[max(.75rem,env(safe-area-inset-bottom))] min-[375px]:p-4 min-[375px]:pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-5">
        <div class="grid grid-cols-2 gap-2"><a href="/download" class="btn-secondary min-h-12 px-2 text-xs min-[375px]:px-3">Get the app</a><a href="/ride?intent=book" class="btn-primary min-h-12 px-2 text-xs min-[375px]:px-3">{t.nav.bookRide}</a></div>
      </div>
    </div>
  </div>
</header>

<style>
  #mobileMenuDrawer { opacity: 0; pointer-events: none; visibility: hidden; transition: opacity 180ms ease, visibility 180ms ease; }
  #mobileMenuPanel { transform: translateX(100%); transition: transform 220ms cubic-bezier(.22, 1, .36, 1); }
  #mobileMenuDrawer[data-open='true'] { opacity: 1; pointer-events: auto; visibility: visible; }
  #mobileMenuDrawer[data-open='true'] #mobileMenuPanel { transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) { #mobileMenuDrawer, #mobileMenuPanel { transition: none; } }
</style>

<script is:inline>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('closeMobileMenuBtn');
  const drawer = document.getElementById('mobileMenuDrawer');
  const panel = document.getElementById('mobileMenuPanel');

  if (mobileBtn && closeBtn && drawer && panel) {
    const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let previousOverflow = '';
    const closeDrawer = (restoreFocus = true) => {
      if (drawer.dataset.open !== 'true') return;
      drawer.dataset.open = 'false';
      drawer.setAttribute('aria-hidden', 'true');
      mobileBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousOverflow;
      if (restoreFocus) mobileBtn.focus();
    };
    const openDrawer = () => {
      if (drawer.dataset.open === 'true') return;
      previousOverflow = document.body.style.overflow;
      drawer.dataset.open = 'true';
      drawer.setAttribute('aria-hidden', 'false');
      mobileBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      panel.querySelector(focusableSelector)?.focus();
    };
    mobileBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', () => closeDrawer());
    drawer.addEventListener('click', (event) => { if (event.target === drawer) closeDrawer(); });
    drawer.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { event.preventDefault(); closeDrawer(); return; }
      if (event.key !== 'Tab') return;
      const focusable = Array.from(panel.querySelectorAll(focusableSelector));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    panel.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', () => closeDrawer(false)));
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => { if (event.matches) closeDrawer(false); });
    window.addEventListener('pagehide', () => closeDrawer(false));
  }
</script>
