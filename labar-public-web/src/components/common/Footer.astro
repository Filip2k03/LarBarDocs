---
import { getTranslation, defaultLocale } from '@/i18n';
interface Props { locale?: 'en' | 'my'; }
const { locale = defaultLocale } = Astro.props;
const t = getTranslation(locale);
---

<div class="mx-auto mt-20 max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="relative overflow-hidden rounded-[2rem] bg-neutral-950 px-6 py-8 text-white shadow-2xl sm:px-9 sm:py-10">
    <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-brand-red/30 blur-3xl"></div>
    <div class="relative flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div><p class="text-[11px] font-bold uppercase tracking-[.2em] text-brand-yellow">A ride that respects your day</p><h2 class="mt-2 text-2xl font-black tracking-tight sm:text-3xl">Ready when you are.</h2><p class="mt-2 max-w-xl text-sm leading-6 text-neutral-400">Plan a route on the web, then continue with the same passenger account in the LaBar app.</p></div>
      <a href="/ride?intent=book" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-full bg-white px-6 text-sm font-bold text-neutral-950 transition hover:bg-brand-yellow">Book a ride <span class="ml-2" aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<footer class="mt-4 border-t border-neutral-200 bg-white pb-10 pt-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 border-b border-neutral-200 pb-12 md:grid-cols-2 lg:grid-cols-6">
      <div class="space-y-4 lg:col-span-2">
        <a href="/" class="flex w-fit items-center gap-3"><img src="/logo.png" alt="LaBar" class="h-9 w-auto" /><span class="text-2xl font-black tracking-tight">La<span class="text-brand-red">Bar</span></span></a>
        <p class="max-w-sm text-sm leading-6 text-neutral-500">{t.footer.tagline} Thoughtful mobility for the people and places that make Myanmar home.</p>
        <a href="/status" class="inline-flex min-h-11 items-center text-xs font-bold text-neutral-700 underline decoration-neutral-300 underline-offset-4 hover:text-brand-red">View API-supplied service status</a>
      </div>
      <div><h3 class="text-xs font-extrabold uppercase tracking-wider">Services</h3><ul class="mt-4 space-y-3 text-sm text-neutral-600"><li><a href="/ride">Ride</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/airport">Airport</a></li><li><a href="/schedule">Schedule</a></li><li><a href="/business">Business</a></li></ul></div>
      <div><h3 class="text-xs font-extrabold uppercase tracking-wider">Partners</h3><ul class="mt-4 space-y-3 text-sm text-neutral-600"><li><a href="/drive">Drive with LaBar</a></li><li><a href="/cities">Cities</a></li><li><a href="/fares">Fares</a></li><li><a href="/promotions">Promotions</a></li><li><a href="/download">Download apps</a></li></ul></div>
      <div><h3 class="text-xs font-extrabold uppercase tracking-wider">Company</h3><ul class="mt-4 space-y-3 text-sm text-neutral-600"><li><a href="/about">About</a></li><li><a href="/careers">Careers</a></li><li><a href="/safety">Safety</a></li><li><a href="/contact">Contact</a></li></ul></div>
      <div><h3 class="text-xs font-extrabold uppercase tracking-wider">Support</h3><ul class="mt-4 space-y-3 text-sm text-neutral-600"><li><a href="/help">Help Center</a></li><li><a href="/legal/privacy">Privacy</a></li><li><a href="/legal/terms">Terms</a></li><li><a href="/legal/cookies">Cookies</a></li></ul></div>
    </div>
    <div class="flex flex-col gap-2 pt-7 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between"><p>© 2026 LaBar Taxi Technologies Co., Ltd. {t.footer.rights}</p><p>Designed for Myanmar journeys.</p></div>
  </div>
</footer>
