---
import Icon from '@/components/common/Icon.astro';
import { getTranslation, defaultLocale } from '@/i18n';

interface Props {
  locale?: 'en' | 'my';
}

const { locale = defaultLocale } = Astro.props;
const t = getTranslation(locale);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Left Headline & Description -->
    <div class="lg:col-span-4 space-y-4">
      <span class="text-xs font-bold text-brand-red uppercase tracking-wider">
        {t.whyChoose.tag}
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-neutral-900 tracking-tight leading-tight">
        {t.whyChoose.title}
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
        {t.whyChoose.subtitle}
      </p>
      <div>
        <a
          href="/safety"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-red hover:text-brand-deepRed transition-colors pt-2 group"
        >
          <span>{t.whyChoose.learnMore}</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right 4 Feature Cards with Crisp Vector SVG Icons -->
    <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1 -->
      <div class="bg-white rounded-3xl p-5 border border-brand-border/80 shadow-soft hover:shadow-soft-md transition-all">
        <div class="w-10 h-10 rounded-2xl bg-red-50 text-brand-red flex items-center justify-center mb-3 border border-red-100">
          <Icon name="driver" size={20} />
        </div>
        <h4 class="text-sm font-extrabold text-neutral-900 mb-1">
          {t.whyChoose.verifiedDrivers}
        </h4>
        <p class="text-xs text-neutral-500 leading-relaxed">
          {t.whyChoose.verifiedDriversSub}
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-3xl p-5 border border-brand-border/80 shadow-soft hover:shadow-soft-md transition-all">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3 border border-emerald-100">
          <Icon name="tracking" size={20} />
        </div>
        <h4 class="text-sm font-extrabold text-neutral-900 mb-1">
          {t.whyChoose.liveTracking}
        </h4>
        <p class="text-xs text-neutral-500 leading-relaxed">
          {t.whyChoose.liveTrackingSub}
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-white rounded-3xl p-5 border border-brand-border/80 shadow-soft hover:shadow-soft-md transition-all">
        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-3 border border-amber-100">
          <Icon name="options" size={20} />
        </div>
        <h4 class="text-sm font-extrabold text-neutral-900 mb-1">
          {t.whyChoose.multipleOptions}
        </h4>
        <p class="text-xs text-neutral-500 leading-relaxed">
          {t.whyChoose.multipleOptionsSub}
        </p>
      </div>

      <!-- Card 4 -->
      <div class="bg-white rounded-3xl p-5 border border-brand-border/80 shadow-soft hover:shadow-soft-md transition-all">
        <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3 border border-blue-100">
          <Icon name="support" size={20} />
        </div>
        <h4 class="text-sm font-extrabold text-neutral-900 mb-1">
          {t.whyChoose.support247}
        </h4>
        <p class="text-xs text-neutral-500 leading-relaxed">
          {t.whyChoose.support247Sub}
        </p>
      </div>
    </div>
  </div>
</section>
