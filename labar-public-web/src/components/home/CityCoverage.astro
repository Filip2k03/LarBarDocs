---
import { CitiesService } from '@/services/cities.service';
import type { City } from '@/types/city';
let cities: City[] = [];
let unavailable = false;
try { cities = await CitiesService.getAllCities(); } catch { unavailable = true; }
---
<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="rounded-[2rem] border border-neutral-200 bg-white p-6 shadow-soft sm:p-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-[11px] font-bold uppercase tracking-[.18em] text-brand-red">API-PUBLISHED COVERAGE</p><h2 class="mt-2 text-2xl font-black tracking-tight text-neutral-950">Meet LaBar where service is active.</h2></div><a href="/cities" class="min-h-11 text-xs font-bold text-brand-red">View service areas →</a></div>
    {unavailable ? <p class="mt-6 rounded-2xl bg-amber-50 p-4 text-xs text-amber-900">City coverage is unavailable; no cities were substituted.</p> : cities.length === 0 ? <p class="mt-6 rounded-2xl bg-neutral-50 p-4 text-xs text-neutral-500">No active cities were returned.</p> : <div class="mt-6 flex flex-wrap gap-2">{cities.map((city) => <a href={`/cities/${city.slug}`} class="rounded-2xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-xs font-bold text-neutral-800 transition hover:border-brand-red hover:bg-red-50 hover:text-brand-red">{city.name}</a>)}</div>}
  </div>
</section>
