---
import { getTranslation, defaultLocale } from '@/i18n';

interface Props {
  locale?: 'en' | 'my';
}

const { locale = defaultLocale } = Astro.props;
const t = getTranslation(locale);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Banner 1: LaBar Guardian Shield -->
    <div class="bg-white rounded-4xl p-6 sm:p-7 border border-brand-border shadow-soft flex flex-col justify-between relative overflow-hidden group hover:shadow-soft-md transition-all">
      <div>
        <span class="text-[11px] font-bold text-brand-red uppercase tracking-wider">
          {t.guardianBanner.tag}
        </span>
        <h3 class="text-xl font-extrabold text-neutral-900 mt-1 mb-4">
          {t.guardianBanner.title}
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-neutral-600 mb-6">
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.guardianBanner.bullet1}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.guardianBanner.bullet2}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.guardianBanner.bullet3}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.guardianBanner.bullet4}</span>
          </li>
        </ul>
      </div>

      <div class="pt-4 border-t border-neutral-100 flex items-center justify-between">
        <a
          href="/safety"
          class="btn-secondary text-xs py-2.5 px-4"
        >
          {t.guardianBanner.learnMore}
        </a>
        <div class="w-12 h-12 rounded-2xl bg-red-50 text-brand-red flex items-center justify-center text-2xl shadow-sm">
          🛡️
        </div>
      </div>
    </div>

    <!-- Banner 2: Drive with LaBar -->
    <div class="bg-white rounded-4xl p-6 sm:p-7 border border-brand-border shadow-soft flex flex-col justify-between relative overflow-hidden group hover:shadow-soft-md transition-all">
      <div>
        <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">
          {t.driverBanner.tag}
        </span>
        <h3 class="text-xl font-extrabold text-neutral-900 mt-1 mb-4">
          {t.driverBanner.title}
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-neutral-600 mb-6">
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.driverBanner.bullet1}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.driverBanner.bullet2}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.driverBanner.bullet3}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>{t.driverBanner.bullet4}</span>
          </li>
        </ul>
      </div>

      <div class="pt-4 border-t border-neutral-100 flex items-center justify-between">
        <a
          href="/drive"
          class="btn-primary text-xs py-2.5 px-4 shadow-sm"
        >
          {t.driverBanner.joinNow}
        </a>
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center text-2xl shadow-sm">
          🚖
        </div>
      </div>
    </div>

    <!-- Banner 3: Download Mobile App -->
    <div class="bg-neutral-900 text-white rounded-4xl p-6 sm:p-7 shadow-soft-lg flex flex-col justify-between relative overflow-hidden group">
      <div>
        <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">
          {t.appBanner.tag}
        </span>
        <h3 class="text-xl font-extrabold text-white mt-1 mb-4">
          {t.appBanner.title}
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-neutral-300 mb-6">
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span>
            <span>{t.appBanner.bullet1}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span>
            <span>{t.appBanner.bullet2}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span>
            <span>{t.appBanner.bullet3}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span>
            <span>{t.appBanner.bullet4}</span>
          </li>
        </ul>
      </div>

      <!-- App Store & Google Play Badges -->
      <div class="pt-4 border-t border-neutral-800 flex flex-wrap items-center gap-2.5">
        <a
          href="/download"
          class="flex items-center gap-2 px-3 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-white text-[11px] font-bold transition-colors border border-neutral-700"
        >
          <span>🍏 App Store</span>
        </a>
        <a
          href="/download"
          class="flex items-center gap-2 px-3 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-white text-[11px] font-bold transition-colors border border-neutral-700"
        >
          <span>▶️ Google Play</span>
        </a>
      </div>
    </div>
  </div>
</section>
