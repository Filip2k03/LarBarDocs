---
import { HeroBookingWidget } from './HeroBookingWidget';
import TaxiAppPreview from './TaxiAppPreview.astro';
import { defaultLocale } from '@/i18n';

interface Props { locale?: 'en' | 'my'; }
const { locale = defaultLocale } = Astro.props;
---

<section class="relative overflow-clip border-b border-neutral-200 bg-[#f7f7f5]">
  <div class="pointer-events-none absolute inset-0 hero-road-grid opacity-60"></div>
  <div class="pointer-events-none absolute -left-36 top-16 h-80 w-80 rounded-full bg-brand-yellow/25 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-32 top-1/3 h-96 w-96 rounded-full bg-red-200/30 blur-3xl"></div>

  <div class="relative mx-auto max-w-[1440px] px-4 pb-28 pt-8 sm:px-6 lg:px-8 lg:pt-14">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(340px,.8fr)] lg:gap-12">
      <div class="min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white/80 px-3.5 py-2 text-[11px] font-bold text-neutral-700 shadow-sm backdrop-blur-xl">
          <span class="h-2 w-2 rounded-full bg-brand-red"></span>
          Made for everyday journeys in Myanmar
        </div>

        <h1 class="mt-6 max-w-4xl text-[clamp(2.7rem,7vw,6.7rem)] font-black leading-[.91] tracking-[-.065em] text-neutral-950">
          Your ride.<br />
          <span class="relative inline-block text-brand-red">Our care.<span class="absolute -bottom-1 left-1 h-2 w-[72%] rounded-full bg-brand-yellow/80 -z-10"></span></span>
        </h1>
        <p class="mt-6 max-w-xl text-base font-medium leading-7 text-neutral-600 sm:text-lg">
          Safe, reliable and transparent transportation across Myanmar—designed to feel calm before, during and after every trip.
        </p>

        <div class="mt-7 flex flex-col gap-3 min-[430px]:flex-row">
          <a href="/ride?intent=book" class="btn-primary min-h-13 px-7 text-sm">Book a ride <span aria-hidden="true">→</span></a>
          <a href="/drive" class="btn-secondary min-h-13 px-7 text-sm">Drive with LaBar</a>
        </div>

        <div class="relative mt-8 lg:-ml-10 lg:mt-5"><TaxiAppPreview /></div>
      </div>

      <div class="lg:sticky lg:top-28 lg:pt-8">
        <HeroBookingWidget client:visible />
        <div class="mx-auto mt-4 grid max-w-md grid-cols-3 gap-2">
          <div class="rounded-2xl border border-neutral-200/80 bg-white/70 p-3 text-center backdrop-blur"><strong class="block text-xs text-neutral-900">Verified</strong><span class="text-[10px] text-neutral-500">driver profiles</span></div>
          <div class="rounded-2xl border border-neutral-200/80 bg-white/70 p-3 text-center backdrop-blur"><strong class="block text-xs text-neutral-900">Live</strong><span class="text-[10px] text-neutral-500">trip progress</span></div>
          <div class="rounded-2xl border border-neutral-200/80 bg-white/70 p-3 text-center backdrop-blur"><strong class="block text-xs text-neutral-900">Clear</strong><span class="text-[10px] text-neutral-500">API pricing</span></div>
        </div>
      </div>
    </div>

  </div>
</section>
