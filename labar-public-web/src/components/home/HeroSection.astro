---
import Icon from '@/components/common/Icon.astro';
import { HeroBookingWidget } from './HeroBookingWidget';
import { Hero3DCanvas } from './Hero3DCanvas';
import { getTranslation, defaultLocale } from '@/i18n';

interface Props {
  locale?: 'en' | 'my';
}

const { locale = defaultLocale } = Astro.props;
const t = getTranslation(locale);
---

<section class="relative overflow-hidden pt-6 pb-14 lg:py-20 bg-gradient-to-b from-white via-brand-bg/60 to-brand-bg border-b border-brand-border/60">
  <div class="relative max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Hero Column: Typography & 3D Interactive WebGL Scene -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Myanmar Heritage Badge with Vector Emblem -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200/80 shadow-soft-sm text-amber-900">
          <Icon name="myanmar-badge" size={15} color="#D97706" />
          <span class="text-[11px] sm:text-xs font-bold tracking-wide">
            {t.hero.badge}
          </span>
        </div>

        <!-- Main Display Headline (Fluid responsive font sizing for 425px & mobile) -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-neutral-900 tracking-tight leading-[1.12]">
          {t.hero.titleLine1} <br />
          <span class="text-amber-500 font-extrabold">{t.hero.titleLine2}</span>
        </h1>

        <!-- Subheading Paragraph -->
        <p class="text-xs sm:text-base text-neutral-600 font-medium leading-relaxed max-w-xl">
          {t.hero.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/ride"
            class="btn-primary text-xs sm:text-sm py-3 px-5 sm:px-6 shadow-soft-md"
          >
            <span>{t.hero.bookNow}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/drive"
            class="btn-secondary text-xs sm:text-sm py-3 px-5 sm:px-6"
          >
            <span>{t.hero.driveWithUs}</span>
          </a>
        </div>

        <!-- Interactive 3D WebGL Three.js Taxi Canvas Island -->
        <div class="pt-4">
          <Hero3DCanvas client:load />
        </div>
      </div>

      <!-- Right Floating Real-Time Booking UI Island Overlay -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end w-full">
        <HeroBookingWidget client:load />
      </div>
    </div>
  </div>
</section>
